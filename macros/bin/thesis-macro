#!/usr/bin/env python3
from pathlib import Path
import csv, sys

ROOT = Path(__file__).resolve().parents[1]
INDEX = ROOT / "MACRO_INDEX.tsv"

def usage(code=2):
    print("Usage: macros/bin/thesis-macro path <id-or-basename>", file=sys.stderr)
    print("       macros/bin/thesis-macro list [group-prefix]", file=sys.stderr)
    raise SystemExit(code)

if len(sys.argv) < 2:
    usage()
cmd = sys.argv[1]
rows = []
with INDEX.open(newline="") as f:
    rows = list(csv.DictReader(f, delimiter="\t"))
if cmd == "list":
    filt = sys.argv[2] if len(sys.argv) > 2 else ""
    for row in rows:
        if not filt or row["group"].startswith(filt):
            print(f"{row['id']}\t{row['group']}\t{row['canonical_path']}")
    raise SystemExit(0)
if cmd != "path" or len(sys.argv) != 3:
    usage()
needle = sys.argv[2]
needle_stem = Path(needle).stem
matches = []
for row in rows:
    base = Path(row["canonical_path"]).name
    if needle in {row["id"], base, row["canonical_path"], row["compatibility_wrapper"]} or needle_stem == row["id"]:
        matches.append(row)
if not matches:
    print(f"[ERROR] Unknown macro id or basename: {needle}", file=sys.stderr)
    raise SystemExit(1)
if len(matches) > 1:
    print(f"[ERROR] Ambiguous macro id or basename: {needle}", file=sys.stderr)
    for row in matches:
        print(f"  {row['id']} -> {row['canonical_path']}", file=sys.stderr)
    raise SystemExit(2)
print(matches[0]["canonical_path"])
