diff --git a/RawClusterBuilderTemplate.cc b/RawClusterBuilderTemplate.cc
--- a/RawClusterBuilderTemplate.cc
+++ b/RawClusterBuilderTemplate.cc
@@ -546,6 +546,25 @@ int RawClusterBuilderTemplate::process_event(PHCompositeNode *topNode)
         unsigned int towerkey = calib_towerinfos->encode_key(channel);
         int ieta = calib_towerinfos->getTowerEtaBin(towerkey);
         int iphi = calib_towerinfos->getTowerPhiBin(towerkey);
+
+        // Some custom embedded TowerInfo containers retain unmapped channel
+        // slots.  Their decoded coordinates are (-1,-1), which would be
+        // converted to 65535 and make RawTowerDefs::encode_towerid abort the
+        // entire process.  These slots are not physical CEMC cells and must
+        // not enter clustering.  Skip them before geometry-key encoding while
+        // keeping a bounded, auditable report for this diagnostic campaign.
+        if (ieta < 0 || ieta >= 96 || iphi < 0 || iphi >= 256)
+        {
+          static unsigned int invalid_tower_coord_reports = 0;
+          if (invalid_tower_coord_reports < 8)
+          {
+            std::cerr << "[RawClusterBuilderTemplate][INVALID_TOWER_COORD]"
+                      << " channel=" << channel << " ieta=" << ieta
+                      << " iphi=" << iphi << " action=skip" << std::endl;
+          }
+          ++invalid_tower_coord_reports;
+          continue;
+        }
 
         const RawTowerDefs::keytype key = RawTowerDefs::encode_towerid(RawTowerDefs::CalorimeterId::CEMC, ieta, iphi);
 
