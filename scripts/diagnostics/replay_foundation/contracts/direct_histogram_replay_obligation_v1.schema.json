{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sphenix.bnl.gov/recoiljets/contracts/direct_histogram_replay_obligation_v1.schema.json",
  "title": "DirectHistogramReplayObligationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "direct_reference",
    "obligations"
  ],
  "properties": {
    "schema": {
      "const": "DirectHistogramReplayObligationV1"
    },
    "schema_version": {
      "const": 1
    },
    "direct_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "system",
        "lane",
        "root_sha256",
        "inventory_sha256",
        "bundle_sha256",
        "code_sha256",
        "schema_sha256",
        "config_sha256",
        "model_registry_sha256",
        "source_manifest_sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "enum": [
            "pp",
            "auau"
          ]
        },
        "lane": {
          "type": "string",
          "minLength": 1
        },
        "root_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "code_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/obligation"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "edges"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "edges": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "sourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tree",
        "branches"
      ],
      "properties": {
        "tree": {
          "type": "string",
          "minLength": 1
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_key",
        "object_class",
        "directory",
        "name",
        "title",
        "axes",
        "source_inputs",
        "selection_rule",
        "fill_rule",
        "ordering_policy",
        "tie_policy",
        "weight_contract",
        "flow_policy",
        "response_classification",
        "equality_contract",
        "analysis_consumers",
        "ian_consumers",
        "recipe_identity_sha256"
      ],
      "properties": {
        "root_key": {
          "type": "string",
          "minLength": 1
        },
        "object_class": {
          "type": "string",
          "pattern": "^(TH[123]|TProfile)"
        },
        "directory": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/axis"
          }
        },
        "source_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceInput"
          }
        },
        "selection_rule": {
          "type": "string",
          "minLength": 1
        },
        "fill_rule": {
          "type": "string",
          "minLength": 1
        },
        "ordering_policy": {
          "type": "string",
          "minLength": 1
        },
        "tie_policy": {
          "type": "string",
          "minLength": 1
        },
        "weight_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "components",
            "application_count",
            "rule"
          ],
          "properties": {
            "components": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "application_count": {
              "const": 1
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "flow_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "underflow",
            "overflow"
          ],
          "properties": {
            "underflow": {
              "type": "string",
              "minLength": 1
            },
            "overflow": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "response_classification": {
          "type": "string",
          "minLength": 1
        },
        "equality_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "numerical_mode",
            "compared_fields"
          ],
          "properties": {
            "status": {
              "const": "REPLAY_EXACT"
            },
            "numerical_mode": {
              "const": "EXACT"
            },
            "compared_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "analysis_consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ian_consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recipe_identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
