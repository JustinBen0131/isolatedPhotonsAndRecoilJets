#!/usr/bin/env python3
"""Resolve and run ThesisAnalysis scripts from the canonical script index."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


REPO = Path(__file__).resolve().parents[2]
SCRIPTS = REPO / "scripts"
COMMAND_INDEX = SCRIPTS / "COMMAND_INDEX.tsv"


def load_rows() -> list[dict[str, str]]:
    if not COMMAND_INDEX.exists():
        raise SystemExit(f"Missing command index: {COMMAND_INDEX}")
    lines = COMMAND_INDEX.read_text().splitlines()
    if not lines:
        return []
    header = lines[0].split("\t")
    rows: list[dict[str, str]] = []
    for line in lines[1:]:
        if not line.strip():
            continue
        values = line.split("\t")
        rows.append(dict(zip(header, values)))
    return rows


def normalize(token: str) -> str:
    token = token.strip().removeprefix("./")
    if token.startswith("scripts/compat/local/"):
        return Path(token).name
    if token.startswith("scripts/"):
        if not (REPO / token).exists() and not (REPO / token).is_symlink():
            return Path(token).name
        return token
    return token


def match(rows: list[dict[str, str]], token: str) -> dict[str, str]:
    q = normalize(token)
    exact: list[dict[str, str]] = []
    basename_matches: list[dict[str, str]] = []
    for row in rows:
        aliases = [a for a in row.get("aliases", "").split(",") if a]
        candidates = {
            row["id"],
            row["basename"],
            row["canonical_path"],
            *aliases,
            *(Path(a).name for a in aliases),
        }
        if q in candidates:
            exact.append(row)
        elif q == Path(row["canonical_path"]).name:
            basename_matches.append(row)
    matches = exact or basename_matches
    if not matches:
        raise SystemExit(f"No script matches: {token}")
    unique = {m["canonical_path"]: m for m in matches}
    if len(unique) > 1:
        print(f"Ambiguous script: {token}", file=sys.stderr)
        for path in sorted(unique):
            print(f"  {path}", file=sys.stderr)
        raise SystemExit(2)
    return next(iter(unique.values()))


def usage() -> None:
    print(
        "Usage:\n"
        "  scripts/bin/thesis-script list [query]\n"
        "  scripts/bin/thesis-script path <id|basename|old-path>\n"
        "  scripts/bin/thesis-script run <id|basename|old-path> [args...]"
    )


def run_script(path: Path, args: list[str]) -> int:
    suffix = path.suffix
    if suffix == ".py":
        cmd = [sys.executable, str(path), *args]
    elif suffix == ".sh":
        cmd = ["bash", str(path), *args]
    elif suffix == ".js":
        cmd = ["node", str(path), *args]
    elif suffix == ".C":
        print(
            f"{path.relative_to(REPO)} is a ROOT macro; use scripts/root_in_analysis_env.sh "
            "or a ROOT command for execution.",
            file=sys.stderr,
        )
        return 2
    else:
        cmd = [str(path), *args]
    return subprocess.call(cmd, cwd=REPO, env=os.environ.copy())


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in {"-h", "--help", "help"}:
        usage()
        return 0
    rows = load_rows()
    command = argv[1]
    if command == "list":
        query = argv[2].lower() if len(argv) > 2 else ""
        for row in rows:
            blob = "\t".join(row.values()).lower()
            if query and query not in blob:
                continue
            print(f"{row['id']}\t{row['canonical_path']}\t{row['domain']}")
        return 0
    if command == "path":
        if len(argv) != 3:
            usage()
            return 2
        print(match(rows, argv[2])["canonical_path"])
        return 0
    if command == "run":
        if len(argv) < 3:
            usage()
            return 2
        row = match(rows, argv[2])
        return run_script(REPO / row["canonical_path"], argv[3:])
    usage()
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
