!/agent_context/THESIS_NARRATIVE_MAP.md
!/agent_context/REPO_ORGANIZATION_MIGRATION_SPEC.md
!/agent_context/REPO_ORGANIZATION_INVENTORY.tsv
!/agent_context/REPO_ORGANIZATION_CLEANUP_MANIFEST.tsv
!/agent_context/policies/
!/agent_context/policies/**
!/agent_context/templates/
!/agent_context/templates/**

# Private local OS state: event logs, snapshots, SDCC details, and local-only
# recovery ledgers must stay off GitHub.
agent_context/local/

!/codex_notes/

!/src/
!/src/**

!/src_AuAu/
!/src_AuAu/**

!/macros/
!/macros/**

!/scripts/
!/scripts/**

